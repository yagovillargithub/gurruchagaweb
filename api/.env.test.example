# .env de la instancia de TEST de la API (demogurru-api-test)
# Copiar a /opt/demogurru-api-test/.env en el VPS y rellenar SMTP_PASS a mano.
# NUNCA commitear el .env real (lleva SMTP_PASS en claro = credencial del mail server).
#
# Diferencias CLAVE respecto a producción (aislamiento test<->prod):
#   - PORT 3101 (prod es 3100) -> segunda instancia systemd independiente.
#   - ALLOWED_ORIGINS apunta al origen de staging (gurru-test), no al de prod.
#   - MAIL_TO va al buzon interno del operador, NO a la clienta (gurru999@gmail.com).
#   - MAIL_FROM marcado [TEST] para distinguir de un correo real de produccion.
#   - STATIC_ROOT apunta al estatico de gurru-test, no al de demogurru.

PORT=3101
HOST=127.0.0.1

SMTP_HOST=mail.unlimited-systems.net
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=info@unlimited-systems.net
# SMTP_PASS: NO va aqui ni se copia a mano. La unit de test lee ANTES el .env de
# PROD (/opt/demogurru-api/.env), que es la fuente unica de la credencial; este
# fichero va despues y NO debe declarar SMTP_PASS (pisaria la real).

# Remitente marcado como TEST y destinatario interno (no la clienta) para no
# contaminar la bandeja real con envios de prueba.
MAIL_FROM="AG Studio [TEST] <info@unlimited-systems.net>"
MAIL_TO=info@unlimited-systems.net

# STATIC_ROOT: debe ser el MISMO path que el DocumentRoot del vhost gurru-test
# (el estatico de staging de donde el API adjunta imagenes de referencia).
# Root: sustituir por la ruta real del DocumentRoot de gurru-test.
# STATIC_ROOT=<DocumentRoot-del-vhost-gurru-test>

ALLOWED_ORIGINS=https://gurru-test.unlimited-systems.net
