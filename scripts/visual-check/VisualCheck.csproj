<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>EventSystem.VisualCheck</RootNamespace>
    <!-- Fuera del EventSystem.sln a proposito: Playwright descarga ~150 MB de
         Chromium la primera vez y la herramienta solo la usa el operador (o un
         agente) cuando hace falta validar pantallas; no queremos que dotnet
         build EventSystem.sln dependa de esto. -->
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Playwright" Version="1.49.0" />
  </ItemGroup>

</Project>
